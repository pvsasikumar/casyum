# Firebase Web App configuration (from Firebase Console > Project settings > General).
# Replace these placeholder values with your project's real values, then restart
# the dev server. The same keys must be configured as environment variables in
# Vercel (Settings > Environment Variables) for production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Client ID used by the Google Sign-In button on the participant
# registration section. Use the web client ID created for this Firebase project
# (credentials can be viewed in Google Cloud Console > APIs & Services > Credentials).
VITE_GOOGLE_CLIENT_ID=
