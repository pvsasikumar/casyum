rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(ref) ? get(ref).data.role : null;
    }

    function isAdmin() {
      return getUserRole() in ['Super Admin', 'Admin'];
    }

    function isSuperAdmin() {
      return getUserRole() == 'Super Admin';
    }

    function isCoordinator() {
      return getUserRole() in [
        'Event Coordinator',
        'Coordinator',
        'Event Coordinator (Student)',
        'Event Coordinator (Faculty)'
      ];
    }

    function isRegistrationTeam() {
      return getUserRole() in ['Registration Team'];
    }

    function isSponsorshipHead() {
      return getUserRole() in ['Sponsorship Head'];
    }

    // Observers have strictly read-only access across the system. They are
    // granted read rules only; no write rule ever includes isObserver(), so
    // every create/update/delete attempt by an observer is denied by Firestore.
    function isObserver() {
      return getUserRole() in ['Observer'];
    }

    function isAssignedEvent(eventId) {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = isSignedIn() && exists(ref) ? get(ref).data : null;
      return data != null && 'assigned_event_ids' in data && eventId in data.assigned_event_ids;
    }

    // Registration Desk verification must be complete before attendance can be
    // recorded for a participant.
    function isVerifiedParticipant(participantId) {
      return get(/databases/$(database)/documents/participants/$(participantId)).data.verificationStatus == 'Verified';
    }

    // Gaming events (Free Fire / BGMI) form a separate category. A participant
    // may choose exactly one gaming event, never both, and gaming events may
    // never be submitted inside the regular selection.
    function isGamingEventName(name) {
      return name == 'Free Fire' || name == 'BGMI';
    }

    function isGamingEventDoc(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      return ev.is_gaming == true
        || ev.category == 'gaming'
        || ev.type == 'gaming'
        || ev.event_type == 'gaming'
        || isGamingEventName(ev.name);
    }

    function isValidRegularList(regular) {
      return regular is list
        && regular.size() <= 2;
    }

    function isValidGamingSelection(gaming) {
      return gaming == null
        || (gaming is map
          && 'eventId' in gaming
          && gaming.eventId is string
          && isGamingEventDoc(gaming.eventId));
    }

    // Bundled selection rules: at most 2 regular events, a single gaming event
    // object (never an array), gaming events excluded from the regular list,
    // and no selection of two regular events combined with a gaming event.
    function isValidSelectedEvents(sel) {
      return sel is map
        && 'regular' in sel
        && isValidRegularList(sel.regular)
        && (!('gaming' in sel) || isValidGamingSelection(sel.gaming))
        && (!('gaming' in sel) || sel.gaming == null || sel.regular.size() < 2);
    }

    // The fee owed for a selection: 150 (regular only), 250 (gaming only) or
    // 400 (regular + gaming). A single-event registration (no selection map)
    // is priced from its event document instead. This makes it impossible to
    // store a manipulated payment amount.
    function getRegularCount(sel) {
      return (sel is map && 'regular' in sel && sel.regular is list) ? sel.regular.size() : 0;
    }

    function hasGamingSelection(sel) {
      return sel is map && 'gaming' in sel && sel.gaming != null;
    }

    function hasSelectedEvents(data) {
      return 'selectedEvents' in data && data.selectedEvents != null;
    }

    function expectedFee(data) {
      return hasSelectedEvents(data)
        ? (getRegularCount(data.selectedEvents) > 0 && hasGamingSelection(data.selectedEvents)) ? 400
          : (getRegularCount(data.selectedEvents) > 0) ? 150
          : (hasGamingSelection(data.selectedEvents)) ? 250
          : 0
        : ('event_id' in data && data.event_id is string && isGamingEventDoc(data.event_id)) ? 250
        : ('event_id' in data && data.event_id is string) ? 150
        : 0;
    }

    function isValidCanonicalFee(data) {
      return 'registrationFee' in data
        && data.registrationFee is number
        && data.registrationFee == expectedFee(data);
    }

    function isValidLegacyFee(data) {
      return 'payment_amount' in data
        && data.payment_amount is number
        && data.payment_amount == expectedFee(data);
    }

    function hasValidSelection(data) {
      return !('selectedEvents' in data)
        || data.selectedEvents == null
        || isValidSelectedEvents(data.selectedEvents);
    }

    // Only the fields below may change when a participant registers for an
    // event (public counter updates). All other writes must come from an
    // admin or an assigned coordinator.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---- Team Formation helpers -------------------------------------------------
    // Team creation/joining is allowed only while the event is a team event
    // with team formation OPEN. The event doc keeps both `team_event` and the
    // legacy `event_type` ('team') markers in sync when the admin configures it.
    function isEventTeamFormationOpen(eventId) {
      let ref = /databases/$(database)/documents/events/$(eventId);
      return exists(ref)
        && get(ref).data.team_formation_enabled == true
        && (get(ref).data.team_event == true || get(ref).data.event_type == 'team');
    }

    // A participant may create/join teams only when their registration payment
    // is verified AND their registration was verified at the Registration Desk.
    // Unpaid, rejected, or unverified participants are never eligible. Both
    // naming conventions are accepted (legacy docs mix `payment_status` with
    // `registrationVerificationStatus`; canonical docs use camelCase).
    function isPaymentVerified(reg) {
      return ('payment_status' in reg && reg.payment_status == 'verified')
        || ('paymentStatus' in reg && reg.paymentStatus == 'verified');
    }

    function isDeskVerified(reg) {
      return ('registration_verification_status' in reg && reg.registration_verification_status == 'verified')
        || ('registrationVerificationStatus' in reg && reg.registrationVerificationStatus == 'verified');
    }

    function isEligibleParticipantForEvent(participantId) {
      let regRef = /databases/$(database)/documents/registrations/$('reg-' + participantId);
      let canonRef = /databases/$(database)/documents/eventRegistrations/$('reg-' + participantId);
      return (exists(regRef) && isPaymentVerified(get(regRef).data) && isDeskVerified(get(regRef).data))
        || (!exists(regRef) && exists(canonRef)
          && isPaymentVerified(get(canonRef).data) && isDeskVerified(get(canonRef).data));
    }

    function isTeamLeader(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.teamLeaderId == request.auth.uid;
    }

    function isTeamMember(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }

    // Fields a participant may change on their own registration when joining or
    // leaving a team (the mirrored team id lives on both registration copies).
    function isParticipantTeamUpdate() {
      return onlyChanges(['teamId', 'teamIds', 'updatedAt', 'updated_at']);
    }

    // Fields a team member may update on the team document (join/leave/lead).
    function isTeamFieldsUpdate() {
      return onlyChanges(['currentMemberCount', 'status', 'teamLeaderId', 'memberIds', 'updatedAt']);
    }

    // Roles that review and verify participant payments. Only the CASYUM
    // Faculty Coordinator and the Super Admin may approve or reject payments.
    function isPaymentReviewer() {
      return getUserRole() in [
        'Super Admin',
        'casyum_faculty_coordinator'
      ];
    }

    // The Registration Desk may only verify a participant in person once their
    // payment has already been verified (or no payment is required).
    function isPaymentAlreadyVerified() {
      return resource.data.paymentStatus in ['verified', 'not_required']
        || resource.data.payment_status in ['verified', 'not_required'];
    }

    // Fields the Registration Desk may update on a registration after the
    // participant is verified/rejected in person.
    function isDeskVerificationUpdate() {
      return onlyChanges([
        'registrationVerificationStatus',
        'registration_verification_status',
        'registrationVerifiedBy',
        'registration_verified_by',
        'registrationVerifiedByName',
        'registration_verified_by_name',
        'registrationVerifiedAt',
        'registration_verified_at',
        'attendanceEligibility',
        'attendance_eligibility',
        'updatedAt',
        'updated_at'
      ]);
    }

    // Fields a participant may update when resubmitting a rejected payment.
    // This is strictly limited to the participant's own payment SUBMISSION
    // fields. Participants may never touch payment verification or rejection
    // audit fields (paymentStatus, paymentVerifiedBy, paymentRejectedBy, etc.)
    // and so can never mark their own payment verified. The only status change
    // a participant may ever make is resetting an already-rejected payment back
    // to `submitted` when they resubmit it.
    function isParticipantPaymentUpdate() {
      return onlyChanges([
        'paymentMethod',
        'payment_method',
        'transactionId',
        'transaction_id',
        'transactionIdNormalized',
        'paymentDate',
        'payment_date',
        'paymentScreenshotUrl',
        'paymentScreenshotFileId',
        'paymentResubmittedAt',
        'payment_resubmitted_at',
        'paymentResubmissionCount',
        'payment_resubmission_count',
        'paymentStatus',
        'payment_status',
        'updatedAt',
        'updated_at'
      ])
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'submitted')
        && (!('payment_status' in request.resource.data) || request.resource.data.payment_status == 'submitted');
    }

    match /users/{userId} {
      // Observers need to read coordinator, faculty and registration team
      // profile summaries for the Observer portal monitoring view. They can
      // never modify any user record.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isObserver());
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      // Public event pages and the public bento grid read the published
      // summary fields stored on the event document. Drafts live in the
      // separate event_drafts collection and are never exposed here.
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isCoordinator() && isAssignedEvent(eventId))
        || (isSignedIn() && onlyChanges(['registered_count', 'updated_at']));
      allow delete: if isAdmin();
    }

    // Published event content: readable by anyone, writable only by admins or
    // the coordinator assigned to that event.
    match /event_cms/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || (isCoordinator() && isAssignedEvent(eventId));
    }

    // Draft event content: never public. Only admins and the assigned
    // coordinator may read or edit the draft. Observers may read drafts so the
    // Observer portal can surface event details before publication.
    match /event_drafts/{eventId} {
      allow read: if isAdmin() || isCoordinator() || isObserver();
      allow write: if isAdmin() || (isCoordinator() && isAssignedEvent(eventId));
    }

    // Website CMS published pages (Home / About / Events / Sponsors / Register):
    // the public website reads them without authentication, so reads are open.
    // Only Admins and the Super Admin may publish or hide pages.
    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website CMS private drafts: never public. Only admins may read or save a
    // draft; drafts are promoted to cms_pages/{pageId} on "Publish Changes".
    match /cms_drafts/{pageId} {
      allow read, write: if isAdmin();
    }

    // Per-event public flags managed by the Website CMS (currently only the
    // rule book visibility switch for the event details page).
    match /cms_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Participants must be able to read and update their own profile, and
    // create their own record on first Google sign-in. Profile fields such as
    // phone, college, city, department and year_of_study are self-serviced by
    // the participant. Registration Desk staff read participants to verify
    // them and may only touch the verification fields.
    match /participants/{participantId} {
      allow read: if isSignedIn() && (isAdmin() || isCoordinator() || isRegistrationTeam() || isPaymentReviewer() || isObserver() || request.auth.uid == participantId);
      allow create: if isSignedIn() && request.auth.uid == participantId;
      allow update: if isSignedIn() && (
        isAdmin()
        || request.auth.uid == participantId
        || (isRegistrationTeam() && onlyChanges([
          'verificationStatus',
          'verifiedBy',
          'verifiedByName',
          'verifiedByUserId',
          'verifiedAt',
          'verificationRemarks',
          'rejectedBy',
          'rejectedByName',
          'rejectedByUserId',
          'rejectedAt',
          'rejectionReason',
          'updated_at'
        ]))
      );
      allow delete: if isAdmin();
    }

    // Registrations: participants may read and create their own; coordinators
    // read registrations for their assigned events; admins and payment
    // reviewers have full access. A participant may hold exactly ONE
    // registration: the document id is always `reg-{participant_id}` (a create
    // with any other id is denied) and a participant may only ever apply
    // payment-resubmission field updates to it, never a second create.
    match /registrations/{registrationId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isPaymentReviewer()
        || isRegistrationTeam()
        || isObserver()
        || (isCoordinator() && isAssignedEvent(resource.data.event_id))
        || request.auth.uid == resource.data.participant_id
        || request.auth.uid == resource.data.participant_user_id
      );
      allow create: if isSignedIn()
        && request.resource.data.participant_id == request.auth.uid
        && request.resource.id == 'reg-' + request.resource.data.participant_id
        && request.resource.data.event_id != null
        && hasValidSelection(request.resource.data)
        && isValidLegacyFee(request.resource.data);
      allow update: if isAdmin() || isPaymentReviewer()
        || (isCoordinator() && isAssignedEvent(resource.data.event_id))
        || (isRegistrationTeam() && isDeskVerificationUpdate() && isPaymentAlreadyVerified())
        || (request.auth.uid == resource.data.participant_id && isParticipantPaymentUpdate())
        || (request.auth.uid == resource.data.participant_id && isParticipantTeamUpdate());
      allow delete: if isAdmin();
    }

    // Canonical event registrations with payment details: participants create
    // and read their own; payment reviewers (Faculty Coordinator) verify/reject
    // payments; the Registration Desk marks desk verification; coordinators
    // read registrations for their assigned events.
    match /eventRegistrations/{registrationId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isPaymentReviewer()
        || isRegistrationTeam()
        || isObserver()
        || (isCoordinator() && isAssignedEvent(resource.data.event_id))
        || request.auth.uid == resource.data.participant_id
        || request.auth.uid == resource.data.participant_user_id
      );
      allow create: if isSignedIn()
        && request.resource.data.participant_id == request.auth.uid
        && request.resource.id == 'reg-' + request.resource.data.participant_id
        && request.resource.data.event_id != null
        && hasValidSelection(request.resource.data)
        && isValidCanonicalFee(request.resource.data);
      allow update: if isSignedIn() && (
        isAdmin()
        || isPaymentReviewer()
        || (isCoordinator() && isAssignedEvent(resource.data.event_id))
        || (isRegistrationTeam() && isDeskVerificationUpdate() && isPaymentAlreadyVerified())
        || (request.auth.uid == resource.data.participant_id && isParticipantPaymentUpdate())
        || (request.auth.uid == resource.data.participant_id && isParticipantTeamUpdate())
      );
      allow delete: if isAdmin();
    }

    // Team Formation: participants form teams for team events once payment is
    // verified and team formation is OPEN. The team document keeps a memberIds
    // list so membership and leader-ship can be validated without collection
    // queries. Admins may remove members and disband teams; disbanding never
    // touches the participants' registrations.
    match /teams/{teamId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isObserver()
        || (isCoordinator() && isAssignedEvent(resource.data.eventId))
        || (isTeamLeader(teamId) || isTeamMember(teamId))
      );
      allow create: if isSignedIn()
        && request.resource.data.teamLeaderId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && isEventTeamFormationOpen(request.resource.data.eventId)
        && isEligibleParticipantForEvent(request.auth.uid)
        && request.resource.data.currentMemberCount == 1
        && request.resource.data.memberIds == [request.auth.uid];
      // A member may update the aggregate fields when joining (their id is added
      // to memberIds), leaving (their id is removed) or leading. Admins may do
      // anything. The memberIds/count/status fields are derived display data;
      // teamMembers is the source of truth.
      allow update: if isSignedIn() && (
        isAdmin()
        || ((isTeamMember(teamId) || request.auth.uid in request.resource.data.memberIds)
            && isTeamFieldsUpdate())
      );
      allow delete: if isAdmin();
    }

    // Team memberships. A participant may only ever be a member of one team per
    // event: the document id is deterministic (`tm-{participantId}-{teamId}`), so
    // a second create for the same pair becomes an update and is denied unless it
    // only touches the allowed role/updatedAt fields. Members may leave freely;
    // the team leader may manage member records; admins may do anything.
    match /teamMembers/{memberId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isObserver()
        || (isCoordinator() && isAssignedEvent(resource.data.eventId))
        || (isTeamLeader(resource.data.teamId) || isTeamMember(resource.data.teamId))
        || request.auth.uid == resource.data.participantId
      );
      allow create: if isSignedIn()
        && request.resource.data.participantId == request.auth.uid
        && isEventTeamFormationOpen(request.resource.data.eventId)
        && isEligibleParticipantForEvent(request.auth.uid);
      allow update: if isSignedIn() && (
        isAdmin()
        || (request.auth.uid == resource.data.participantId && onlyChanges(['role', 'updatedAt']))
        || isTeamLeader(resource.data.teamId)
      );
      allow delete: if isSignedIn() && (
        isAdmin()
        || request.auth.uid == resource.data.participantId
        || isTeamLeader(resource.data.teamId)
      );
    }

    // Team formation access records: written ONLY by admins when team formation
    // is enabled (the in-app "Team Formation is Now Open" notification lives on
    // these docs). Participants can read their own record; admins read/write all.
    match /teamFormationAccess/{accessId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || request.auth.uid == resource.data.participantId
      );
      allow write: if isSignedIn() && isAdmin();
    }

    // Attendance: a coordinator can only create/update/delete attendance for
    // their assigned event, and only for participants whose verification is
    // complete at the Registration Desk. Admins and payment reviewers have
    // full read access.
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (isAdmin() || isPaymentReviewer() || isObserver() || isCoordinator() && isAssignedEvent(resource.data.event_id));
      allow create: if isSignedIn() && (isAdmin() || (isCoordinator() && isAssignedEvent(request.resource.data.event_id) && isVerifiedParticipant(request.resource.data.participant_id)));
      allow update: if isSignedIn() && (isAdmin() || (isCoordinator() && isAssignedEvent(resource.data.event_id) && isAssignedEvent(request.resource.data.event_id) && isVerifiedParticipant(request.resource.data.participant_id)));
      allow delete: if isSignedIn() && (isAdmin() || isCoordinator() && isAssignedEvent(resource.data.event_id));
    }

    // Registration Desk verification records and audit logs.
    match /verification_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isRegistrationTeam() || isPaymentReviewer() || isObserver());
      allow write: if isAdmin() || isRegistrationTeam();
    }

    match /participant_verifications/{recordId} {
      allow read: if isSignedIn() && (isAdmin() || isRegistrationTeam() || isPaymentReviewer() || isObserver());
      allow write: if isAdmin() || isRegistrationTeam();
    }

    match /registration_team_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isRegistrationTeam() || isObserver());
      allow write: if isAdmin() || isRegistrationTeam();
    }

    // CASYUM Faculty Coordinator account logs: only admins may read/write.
    match /casyum_faculty_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isObserver());
      allow write: if isSignedIn() && isAdmin();
    }

    // CASYUM Observer account logs: only admins may read/write.
    match /observer_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && isAdmin();
    }

    // Payment review audit trail written by the CASYUM Faculty portal.
    match /payment_verification_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isPaymentReviewer() || isObserver());
      allow write: if isSignedIn() && (isAdmin() || isPaymentReviewer());
    }

    // Payment records managed by the admin participant update flow.
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isAdmin() || isPaymentReviewer() || isRegistrationTeam());
      allow write: if isSignedIn() && isAdmin();
    }

    // App-wide configuration (settings/app) is admin-only. Payment collection
    // settings (settings/payment) hold the QR/UPI/bank instructions shown on
    // the participant payment form, so they must be publicly readable; only
    // admins may change them. Communication settings (settings/communication)
    // are handled by their own dedicated rule below, so they are explicitly
    // excluded here to avoid granting broader write access via overlapping
    // match statements.
    match /settings/{docId} {
      allow read: if docId == 'payment' || docId == 'ruleBook'
        || (docId != 'communication' && docId != 'sponsorship' && isAdmin());
      allow write: if docId != 'communication' && docId != 'sponsorship' && isAdmin();
    }

    // Sponsorship settings (active tariff PDF URL + Sponsorship Head contact):
    // the tariff PDF link must be publicly readable so visitors can open the
    // "View Sponsorship Packages" button without signing in; only the Super
    // Admin may change it.
    match /settings/sponsorship {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Sponsor categories drive the sponsor showcase grouping. They are
    // readable by everyone (they contain no sensitive data) and managed
    // entirely by the Super Admin.
    match /sponsorCategories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Sponsorship packages define display level, logo size and benefits per
    // package. Readable by everyone, managed by the Super Admin.
    match /sponsorPackages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Sponsors: the public website loads the sponsor showcase from Firestore
    // without authentication, so reads are public. Only sponsors with
    // status == 'Active' and approvalStatus == 'Approved' are rendered by the
    // public UI (filtered client-side), so pending/rejected sponsors never
    // appear publicly. Only the Super Admin manages the sponsor records
    // (create / enable / disable / reorder / delete). The Sponsorship Head
    // may create a sponsor when approving an enquiry and may edit the
    // sponsors they manage, but can never delete one.
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isSponsorshipHead();
      allow update: if isSuperAdmin() || isSponsorshipHead();
      allow delete: if isSuperAdmin();
    }

    // Sponsorship enquiries: anyone may submit one from the public website.
    // Only the Super Admin, Admin and Sponsorship Head may read/update them.
    // Deletion is limited to the Super Admin.
    match /sponsorshipEnquiries/{enquiryId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isAdmin() || isSponsorshipHead());
      allow create: if true;
      allow update: if isSuperAdmin() || isSponsorshipHead();
      allow delete: if isSuperAdmin();
    }

    // Certificates and event results: admins manage them; observers may read
    // the status summary but can never modify anything.
    match /certificates/{certificateId} {
      allow read: if isSignedIn() && (isAdmin() || isObserver());
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isSignedIn() && (isAdmin() || isObserver());
      allow write: if isAdmin();
    }

    // Communication settings (settings/communication) drive the WhatsApp group
    // invitation popup shown to participants after a successful registration.
    // Participants must be able to read them, but only the Super Admin may edit
    // the group name, invite link, description or enable/disable the popup.
    match /settings/communication {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Sequence counters are read and incremented when participants register.
    match /counters/{key} {
      allow read, write: if isSignedIn();
    }

    // Email audit logs (written by the admin email module and team formation
    // notifications). Admins read/write; everyone else is denied by default.
    match /emailLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && isAdmin();
    }

    // The CASYUM id counter document (`systemCounters/participantCounter`) is
    // read and incremented atomically inside the same transaction that creates
    // a participant document, so signed-in participants and admins must be able
    // to touch it. It only ever stores a single integer (`current`) — never
    // participant data — mirroring the existing `/counters/{key}` rule.
    match /systemCounters/{key} {
      allow read, write: if isSignedIn();
    }
  }
}
